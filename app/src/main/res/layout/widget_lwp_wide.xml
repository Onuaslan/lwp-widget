<?xml version="1.0" encoding="utf-8"?>
<!-- Breites, flaches Layout (Querformat): links Live-Werte, Tag und Summe, rechts Knöpfe und Diagramm -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:baselineAligned="false"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="150dp"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="58dp"
                    android:layout_height="wrap_content"
                    android:text="Außen"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/outdoor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="–"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/flow_label"
                    android:layout_width="58dp"
                    android:layout_height="wrap_content"
                    android:text="Vorlauf"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/flow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="–"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="58dp"
                    android:layout_height="wrap_content"
                    android:text="WW"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tank_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="–"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/activity_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/dot_idle" />

                <TextView
                    android:id="@+id/activity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="–"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/prev"
                android:layout_width="30dp"
                android:layout_height="40dp"
                android:contentDescription="Vorheriger Tag"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:src="@drawable/ic_chevron_left" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/total_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24 11 2026"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/updated"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Tippen zum Aktualisieren"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/next"
                android:layout_width="30dp"
                android:layout_height="40dp"
                android:contentDescription="Nächster Tag"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:src="@drawable/ic_chevron_right" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.00"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="10dp"
                android:text="kWh"
                android:textColor="@color/text_primary"
                android:textSize="12sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/refresh"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/refresh_bg"
                android:contentDescription="Aktualisieren"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_refresh" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Betriebsart direkt wählen, wie am Bedienpanel. Rechts davon Warmwasser erzwingen. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/op_heat_water"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/pill_off"
                android:contentDescription="Heizen und Warmwasser"
                android:paddingStart="6dp"
                android:paddingTop="4dp"
                android:paddingEnd="6dp"
                android:paddingBottom="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/mode_heat_water" />
            <ImageView
                android:id="@+id/op_heat"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/pill_off"
                android:contentDescription="Heizen"
                android:paddingStart="6dp"
                android:paddingTop="4dp"
                android:paddingEnd="6dp"
                android:paddingBottom="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/mode_heat" />
            <ImageView
                android:id="@+id/op_water"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/pill_off"
                android:contentDescription="Warmwasser"
                android:paddingStart="6dp"
                android:paddingTop="4dp"
                android:paddingEnd="6dp"
                android:paddingBottom="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/mode_water" />
            <ImageView
                android:id="@+id/op_cool_water"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/pill_off"
                android:contentDescription="Kühlen und Warmwasser"
                android:paddingStart="6dp"
                android:paddingTop="4dp"
                android:paddingEnd="6dp"
                android:paddingBottom="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/mode_cool_water" />
            <ImageView
                android:id="@+id/op_cool"
                android:layout_width="44dp"
                android:layout_height="40dp"
                android:layout_marginEnd="2dp"
                android:background="@drawable/pill_off"
                android:contentDescription="Kühlen"
                android:paddingStart="6dp"
                android:paddingTop="4dp"
                android:paddingEnd="6dp"
                android:paddingBottom="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/mode_cool" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/force_toggle"
                android:layout_width="50dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/pill_off"
                android:contentDescription="Warmwasser erzwingen (Notbetrieb)"
                android:paddingStart="6dp"
                android:paddingTop="4dp"
                android:paddingEnd="6dp"
                android:paddingBottom="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/mode_force_dhw" />

            <TextView
                android:id="@+id/mode_pending"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:text="…"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Legende wie in der App: Warmwasser, Heizen, Kühlen (bei wenig Höhe ausgeblendet) -->
        <LinearLayout
            android:id="@+id/legend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/chip_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="7dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp">

                <ImageView
                    android:layout_width="7dp"
                    android:layout_height="11dp"
                    android:layout_marginEnd="5dp"
                    android:src="@drawable/legend_hot_water" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Warmwasser"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="@drawable/chip_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="7dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp">

                <ImageView
                    android:layout_width="7dp"
                    android:layout_height="11dp"
                    android:layout_marginEnd="5dp"
                    android:src="@drawable/legend_heat" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Heizen"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/chip_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="7dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp">

                <ImageView
                    android:layout_width="7dp"
                    android:layout_height="11dp"
                    android:layout_marginEnd="5dp"
                    android:src="@drawable/legend_cool" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kühlen"
                    android:textColor="@color/text_primary"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/chart"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:contentDescription="Stündlicher Verbrauch"
            android:scaleType="fitCenter" />
    </LinearLayout>
</LinearLayout>
